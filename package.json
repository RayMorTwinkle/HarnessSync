{
  "name": "harness-sync",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Local-first instructions and skills for your AI harnesses",
  "repository": {
    "type": "git",
    "url": "https://github.com/RayMorTwinkle/HarnessSync.git"
  },
  "homepage": "https://github.com/RayMorTwinkle/HarnessSync#readme",
  "bugs": "https://github.com/RayMorTwinkle/HarnessSync/issues",
  "bin": {
    "hsync": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli.ts serve --dev",
    "cli": "tsx src/cli.ts",
    "build": "tsc --noEmit && vite build && esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests vite.config.ts tsconfig.json index.html package.json README.md CONTEXT.md AGENTS.md docs skills"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
